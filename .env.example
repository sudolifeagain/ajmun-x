# ============================================================================
# Required Environment Variables
# ============================================================================

# Application Signing Secret (required, minimum 32 random characters)
# Signs QR tokens and derives a separate JWT session key using HKDF-SHA256.
# No additional SESSION_SECRET is needed.
QR_SECRET=

# SQLite database URL (Docker production: file:/app/data/prod.db)
DATABASE_URL=

# Discord Bot Token
DISCORD_BOT_TOKEN=

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ============================================================================
# Optional Environment Variables
# ============================================================================

# Base URL for the application (required HTTPS URL in production)
NEXT_PUBLIC_BASE_URL=

# Export API Key (for Google Sheets integration, minimum 32 characters)
EXPORT_API_KEY=

# Discord Webhook URL for logging
DISCORD_LOG_WEBHOOK_URL=
